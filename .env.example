# Secretos exclusivos del servidor. Nunca uses el prefijo VITE_.
# El panel de coordinación en Sites/D1 requiere ambos valores.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-private-password
PREVIEW_GUEST_CODE=replace-with-a-private-preview-code
PREVIEW_LINK_TOKEN=replace-with-a-long-random-link-token

# Lista privada. Guarda hashes SHA-256, nunca códigos o tokens en claro.
# Campos: id, codeHash y/o linkHash, name, partyLimit, plusOneAllowed, companionNames.
# codeHash = SHA-256 del código con trim + mayúsculas; linkHash = SHA-256 del token con trim.
PRIVATE_GUESTS_JSON=[]
