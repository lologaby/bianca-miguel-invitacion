# Variables del servidor de producción en Vercel. Nunca uses el prefijo VITE_.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-at-least-12-private-characters

# En Vercel, utiliza el valor que proporciona la integración de Redis.
# Esta dirección es solo un ejemplo para una base local.
REDIS_URL=redis://localhost:6379

# Lista inicial privada; las altas del panel se guardan en Redis.
# Campos: id, codeHash, linkHash opcional, name, partyLimit, plusOneAllowed.
# codeHash: SHA-256 del código en mayúsculas, sin caracteres ajenos a A-Z o 0-9.
GUESTS_JSON=[]

# Configuración privada con la estructura PrivateEvent de src/types/invitation.ts.
# Completar en Vercel; no guardar datos reales del evento en este archivo.
PRIVATE_EVENT_JSON={}
