# Secretos exclusivos del servidor. Nunca uses el prefijo VITE_.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-private-password
PREVIEW_GUEST_CODE=replace-with-a-private-preview-code
PREVIEW_LINK_TOKEN=replace-with-a-long-random-link-token
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Lista privada. Guarda hashes SHA-256, nunca códigos o tokens en claro.
# Campos: id, codeHash, linkHash, name, partyLimit, plusOneAllowed, companionNames
GUESTS_JSON=[]

# Los detalles no se incluyen en el JavaScript público; la API los entrega tras validar al invitado.
PRIVATE_EVENT_JSON={"couple":{"first":"Bianca","second":"Placeholder"},"dateLabel":"26 de diciembre de 2026","dateShort":"26 · 12 · 2026","start":"2026-12-26T17:00:00-04:00","end":"2026-12-27T02:00:00-04:00","timezone":"America/Puerto_Rico","timeLabel":"Hora por confirmar","ceremony":{"name":"Lugar de ceremonia","city":"Ponce, Puerto Rico","mapsUrl":"https://example.com"},"reception":{"name":"Lugar de recepción","note":"Detalles para invitados validados."}}
